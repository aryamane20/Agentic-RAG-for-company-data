# Copy this file to .env and fill in real values.
# .env is gitignored -- never commit real secrets.

# Required -- LLM provider (Groq). Get a free key at console.groq.com.
GROQ_API_KEY=

# Optional -- defaults to openai/gpt-oss-120b if unset.
GROQ_MODEL=

# Required -- signs and verifies login JWTs. Use a long random string, e.g.
# `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`
JWT_SECRET=

# Required -- the Next.js frontend's origin, for CORS. The API only
# accepts cross-origin browser requests from this exact origin.
FRONTEND_ORIGIN=http://localhost:3000

# Optional -- Langfuse tracing (https://langfuse.com). Leave all three
# blank to run with tracing off; /chat works identically either way.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# Database connection -- only needed when running scripts (ask.py,
# run_eval.py, etc.) directly on the host, outside Docker Compose. Inside
# Compose, docker-compose.yml sets these explicitly to point at the
# `postgres` service and overrides whatever is here.
DB_HOST=localhost
DB_PORT=5435
DB_NAME=rag_db
DB_USER=rag_user
DB_PASSWORD=rag_password

# Not something you set upfront -- seed_test_users.py generates a random
# password for each test user the first time it creates them, and prints
# it once along with the exact env var name (TEST_HR_STAFF_PASSWORD,
# TEST_ENGINEER_PASSWORD, TEST_EXECUTIVE_PASSWORD) to add it under. Only
# needed if you use run_guardrail_checks.py.
